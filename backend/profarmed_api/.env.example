# === CONFIGURACIÓN DE BASE DE DATOS (DOCKER / LOCAL) ===
DATABASE_URL=postgresql://profarmed_user:supersecretpassword@localhost:5432/profarmed_db

# === SEGURIDAD Y JWT ===
SECRET_KEY=change_this_secret_key_in_production
ALGORITHM=HS256

# === CONFIGURACIÓN DE LA API ===
PROJECT_NAME=Profarmed API
FRONTEND_URL=*

# === CONFIGURACIÓN DE EMAIL (SMTP) ===
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER=notificaciones@profarmed.com.mx
CONTACT_EMAIL=contacto@profarmed.com.mx

# === CONFIGURACIÓN DE TERCEROS (CLOUDFLARE TURNSTILE) ===
TURNSTILE_SECRET_KEY=

# === CONFIGURACIÓN DE AWS S3 / CDN ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

BUCKET_DOCS=profarmed-docs
BUCKET_PROMOS=profarmed-promos
CLOUDFRONT_PROMOS_URL=promos.profarmed.com.mx
BUCKET_IMGS=profarmed-imgs
CLOUDFRONT_IMGS_URL=img.profarmed.com.mx
