# API Base URL (ej. http://localhost:8000 o https://api.tudominio.com)
VITE_API_BASE_URL=http://localhost:8000

# Cloudflare Turnstile CAPTCHA (Site Key pública correspondiente al dominio)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...

# Marca e Identidad
VITE_BRAND_NAME=Profarmed
# El color PWA/tema se obtiene automáticamente de src/styles/tokens/_colors.scss (--color-primary)
